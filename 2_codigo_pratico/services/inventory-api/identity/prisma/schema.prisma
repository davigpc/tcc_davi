generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  OPERATOR
}

// ─── Models (propriedade do serviço de Identidade) ───────────────────────────
// A tabela `warehouses` pertence ao serviço de Estoque; `warehouseId` é apenas
// uma referência lógica (sem integridade referencial entre bancos).

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String    @map("password_hash")
  role             Role
  warehouseId      String?   @map("warehouse_id")
  refreshTokenHash String?   @map("refresh_token_hash")
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  @@map("users")
}
