{
  "app": "auction",
  "metodologias": ["subdominio"],
  "composeDir": "2_codigo_pratico/infra/compose",
  "composeFile": "auction-subdominio-final.yml",
  "codeDir": "2_codigo_pratico/services/auction",
  "composeProject": "auction-subdominio-final",
  "baseUrl": "http://localhost:3000",
  "readinessPath": "/health",
  "loginPath": "/auth/login",
  "credentials": { "email": "bidder@example.com", "password": "password123" },
  "seed": [
    { "service": "identidade", "command": ["node", "scripts/seed-local.js"] },
    { "service": "catalogo", "command": ["node", "scripts/seed-local.js"] },
    { "service": "leilao", "command": ["node", "scripts/seed-local.js"] }
  ],
  "containers": [
    "auction_sub_final_identity_db",
    "auction_sub_final_catalogo_db",
    "auction_sub_final_leilao_db",
    "auction_sub_final_redis",
    "auction_sub_final_identidade",
    "auction_sub_final_catalogo",
    "auction_sub_final_leilao",
    "auction_sub_final_leilao_worker",
    "auction_sub_final_tempo_real",
    "auction_sub_final_nginx"
  ],
  "images": [
    "auction-sub-final-identidade",
    "auction-sub-final-catalogo",
    "auction-sub-final-leilao",
    "auction-sub-final-tempo-real",
    "postgres:16",
    "redis:7",
    "nginx:alpine"
  ],
  "sourceDirs": [
    "2_codigo_pratico/services/auction/nucleo/src",
    "2_codigo_pratico/services/auction/identidade/src",
    "2_codigo_pratico/services/auction/catalogo/src",
    "2_codigo_pratico/services/auction/tempo-real/src"
  ],
  "crossDomain": [
    {
      "label": "nucleo",
      "dir": "2_codigo_pratico/services/auction/nucleo/src",
      "tsConfig": "2_codigo_pratico/services/auction/nucleo/tsconfig.json"
    },
    {
      "label": "identidade",
      "dir": "2_codigo_pratico/services/auction/identidade/src",
      "tsConfig": "2_codigo_pratico/services/auction/identidade/tsconfig.json"
    },
    {
      "label": "catalogo",
      "dir": "2_codigo_pratico/services/auction/catalogo/src",
      "tsConfig": "2_codigo_pratico/services/auction/catalogo/tsconfig.json"
    },
    {
      "label": "tempo-real",
      "dir": "2_codigo_pratico/services/auction/tempo-real/src",
      "tsConfig": "2_codigo_pratico/services/auction/tempo-real/tsconfig.json"
    }
  ],
  "ids": {
    "userId": { "from": "login", "path": "user.id" },
    "auctionId": { "from": "seed", "path": "auctionId" }
  },
  "routes": {
    "read": [
      {
        "name": "auctions",
        "method": "GET",
        "path": "/auctions?limit=10"
      },
      {
        "name": "auction-by-id",
        "method": "GET",
        "path": "/auctions/{{auctionId}}"
      }
    ],
    "write": [
      {
        "name": "bids",
        "method": "POST",
        "path": "/auctions/{{auctionId}}/bids",
        "auth": true,
        "connections": 1,
        "sequence": { "field": "amount", "start": 100 },
        "body": { "amount": 100 }
      }
    ]
  },
  "load": { "connections": 20, "durationSec": 10, "pipelining": 1, "reps": 3 },
  "buildReps": 3,
  "startupReps": 3,
  "statsIdleSec": 15,
  "statsLoadSec": 15
}
