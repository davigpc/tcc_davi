{
  "app": "inventory-api",
  "metodologias": ["subdominio"],
  "composeDir": "2_codigo_pratico/infra/compose",
  "composeFile": "inventory-api-subdominio-s2.yml",
  "codeDir": "2_codigo_pratico/apps/inventory-api",
  "composeProject": "inventory-api-sub-s2",
  "baseUrl": "http://localhost:3000",
  "readinessPath": "/docs",
  "credentials": { "email": "admin@example.com", "password": "admin123" },
  "seed": {
    "service": "monolith",
    "command": ["node", "dist/src/database/seeds/seed.js"]
  },
  "containers": [
    "inventory_sub_s2_db",
    "inventory_sub_s2_monolith",
    "inventory_sub_s2_support",
    "inventory_sub_s2_reports",
    "inventory_sub_s2_identity",
    "inventory_sub_s2_nginx"
  ],
  "images": [
    "inventory-api-sub-s2-monolith",
    "inventory-api-sub-s2-support",
    "inventory-api-sub-s2-reports",
    "inventory-api-sub-s2-identity",
    "nginx:alpine"
  ],
  "sourceDirs": [
    "2_codigo_pratico/apps/inventory-api/src",
    "2_codigo_pratico/services/inventory-api/support/src",
    "2_codigo_pratico/services/inventory-api/reports/src",
    "2_codigo_pratico/services/inventory-api/identity/src"
  ],
  "routes": {
    "read": [
      { "name": "reports-movements", "method": "GET", "path": "/api/reports/movements", "auth": true },
      { "name": "reports-stock", "method": "GET", "path": "/api/reports/stock/{{warehouseId}}", "auth": true },
      { "name": "products", "method": "GET", "path": "/api/products", "auth": true }
    ],
    "write": [
      {
        "name": "movements-post",
        "method": "POST",
        "path": "/api/movements",
        "auth": true,
        "body": {
          "productId": "{{productId}}",
          "warehouseId": "{{warehouseId}}",
          "type": "ENTRADA",
          "quantity": 1,
          "notes": "load-test"
        }
      }
    ]
  },
  "load": { "connections": 20, "durationSec": 10, "pipelining": 1, "reps": 3 },
  "buildReps": 3,
  "startupReps": 3,
  "statsIdleSec": 15,
  "statsLoadSec": 15
}
