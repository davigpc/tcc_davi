{
  "app": "ecommerce",
  "metodologias": ["subdominio"],
  "composeDir": "2_codigo_pratico/infra/compose",
  "composeFile": "ecommerce-subdominio-s1.yml",
  "codeDir": "2_codigo_pratico/apps/ecommerce",
  "composeProject": "ecommerce-subdominio-s1",
  "baseUrl": "http://localhost:3001",
  "readinessPath": "/api/health/db",
  "credentials": { "email": "buyer@example.com", "password": "password123" },
  "seed": {
    "service": "monolith",
    "command": ["node", "scripts/seed-local.js"]
  },
  "containers": [
    "ecommerce_sub_s1_mongo",
    "ecommerce_sub_s1_redis",
    "ecommerce_sub_s1_monolith",
    "ecommerce_sub_s1_identidade",
    "ecommerce_sub_s1_comunicacao",
    "ecommerce_sub_s1_nginx"
  ],
  "images": [
    "ecommerce-subdominio-s1-monolith",
    "ecommerce-subdominio-s1-identidade",
    "ecommerce-subdominio-s1-comunicacao",
    "mongo:7",
    "redis:7-alpine",
    "nginx:alpine"
  ],
  "sourceDirs": [
    "2_codigo_pratico/apps/ecommerce/src",
    "2_codigo_pratico/services/ecommerce/identidade/src",
    "2_codigo_pratico/services/ecommerce/comunicacao/src"
  ],
  "crossDomain": [
    {
      "label": "ecommerce",
      "dir": "2_codigo_pratico/apps/ecommerce/src/modules",
      "tsConfig": "2_codigo_pratico/apps/ecommerce/tsconfig.json"
    },
    {
      "label": "identidade",
      "dir": "2_codigo_pratico/services/ecommerce/identidade/src/modules",
      "tsConfig": "2_codigo_pratico/services/ecommerce/identidade/tsconfig.json"
    },
    {
      "label": "comunicacao",
      "dir": "2_codigo_pratico/services/ecommerce/comunicacao/src/modules",
      "tsConfig": "2_codigo_pratico/services/ecommerce/comunicacao/tsconfig.json"
    }
  ],
  "sharedModuleAlias": "shared",
  "ids": {
    "userId": { "from": "login", "path": "user._id" },
    "productId": { "url": "/api/products?page=1&size=10", "path": "[0]._id" }
  },
  "routes": {
    "read": [
      {
        "name": "products",
        "method": "GET",
        "path": "/api/products?page=1&size=10"
      },
      {
        "name": "product-by-id",
        "method": "GET",
        "path": "/api/products/{{productId}}"
      }
    ],
    "write": [
      {
        "name": "orders",
        "method": "POST",
        "path": "/api/orders",
        "auth": true,
        "body": {
          "customer": "{{userId}}",
          "items": [
            {
              "id": "{{productId}}",
              "type": "Product",
              "quantity": 1
            }
          ],
          "amount": 101,
          "billing_details": {
            "name": "Seed Buyer",
            "email": "buyer@example.com",
            "address": "Rua 1",
            "city": "São João del-Rei",
            "postcode": "36300-000",
            "phone": "+550000000000"
          },
          "order_notes": "load-test"
        }
      }
    ]
  },
  "load": { "connections": 20, "durationSec": 10, "pipelining": 1, "reps": 3 },
  "buildReps": 3,
  "startupReps": 3,
  "statsIdleSec": 15,
  "statsLoadSec": 15
}
