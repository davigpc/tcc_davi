{
  "app": "auction",
  "metodologias": ["capacidade-negocio", "subdominio", "transacoes"],
  "composeDir": "2_codigo_pratico/infra/compose",
  "composeFile": "auction-baseline.yml",
  "composeProject": "auction-baseline",
  "baseUrl": "http://localhost:3000",
  "readinessPath": "/health",
  "loginPath": "/auth/login",
  "credentials": { "email": "bidder@example.com", "password": "password123" },
  "seed": {
    "service": "api",
    "command": ["node", "scripts/seed-local.js"]
  },
  "containers": [
    "auction_baseline_api",
    "auction_baseline_worker",
    "auction_baseline_postgres",
    "auction_baseline_redis"
  ],
  "images": [
    "auction-baseline-app",
    "postgres:16",
    "redis:7"
  ],
  "sourceDirs": ["2_codigo_pratico/apps/auction/src"],
  "crossDomainDirs": ["2_codigo_pratico/apps/auction/src"],
  "tsConfig": "2_codigo_pratico/apps/auction/tsconfig.json",
  "ids": {
    "userId": { "from": "login", "path": "user.id" },
    "auctionId": { "from": "seed", "path": "auctionId" }
  },
  "routes": {
    "read": [
      {
        "name": "auctions",
        "method": "GET",
        "path": "/auctions?limit=10"
      },
      {
        "name": "auction-by-id",
        "method": "GET",
        "path": "/auctions/{{auctionId}}"
      }
    ],
    "write": [
      {
        "name": "bids",
        "method": "POST",
        "path": "/auctions/{{auctionId}}/bids",
        "auth": true,
        "connections": 1,
        "sequence": { "field": "amount", "start": 100 },
        "body": { "amount": 100 }
      }
    ]
  },
  "load": { "connections": 20, "durationSec": 10, "pipelining": 1, "reps": 3 },
  "buildReps": 3,
  "startupReps": 3,
  "statsIdleSec": 15,
  "statsLoadSec": 15
}
